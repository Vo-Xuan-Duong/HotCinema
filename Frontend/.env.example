# Vite environment variables
# Copy this file to .env and replace placeholder values.

# Frontend mock mode
# - Development defaults to mock mode when this variable is omitted.
# - Set false to connect to the real backend.
VITE_USE_MOCK_DATA=true
VITE_MOCK_API_DELAY=280

# Real backend / realtime endpoints
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_BOOKING_WS_URL=http://localhost:8080/ws-booking

# Frontend feature configuration
VITE_PAYMENT_METHODS=MOMO,VNPAY,ZALOPAY
VITE_API_CACHE_TTL_MS=300000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_MAPS_API_KEY=your-browser-restricted-google-maps-key

# Media uploads
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
VITE_CLOUDINARY_API_KEY=your-api-key
